NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://atelier:atelier@localhost:5432/atelier
DATABASE_URL_TEST=postgres://test:test@localhost:5433/atelier_test
SESSION_SECRET=generate-a-long-random-string

# Demo Persona Bootstrap (Set DEMO_MODE=true only in showcase/demo environments such as Vercel)
# Disabled (false) by default so production deployments never execute backdoor credential resets
DEMO_MODE=true

# Paymob Payment Gateway Configuration
# Set PAYMOB_SANDBOX_MODE to true for local testing/simulation mode
PAYMOB_SANDBOX_MODE=true
# Your master API Key from Paymob Settings > Account Info
PAYMOB_API_KEY=
# Secret Key from Settings > Account Info (used for modern Intention API)
PAYMOB_SECRET_KEY=
# Public Key from Settings > Account Info (used for client SDKs)
PAYMOB_PUBLIC_KEY=
# Numerical ID of your Payment Integration (Card 3DS) from Developers > Payment Integrations
PAYMOB_INTEGRATION_ID=
# HMAC secret for validating webhooks from Settings > Profile
PAYMOB_HMAC_SECRET=
# Numerical ID of your customized iFrame from Developers > iframes
PAYMOB_IFRAME_ID=
# Default currency: EGP, AED, SAR, or USD
PAYMOB_CURRENCY=EGP
