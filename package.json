{
  "name": "atelier-market-postgres",
  "version": "1.0.0",
  "description": "Atelier Market - PostgreSQL & Docker Edition",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "app.js",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "test": "vitest run",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "npm --prefix client install --include=dev",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "node scripts/seed.js"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^10.0.0",
    "cross-env": "^10.1.0",
    "csurf": "^1.11.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "nodemailer-sendgrid-transport": "^0.2.0",
    "pdfkit": "^0.19.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  }
}
